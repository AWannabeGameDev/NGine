#version 460 core
#extension GL_ARB_bindless_texture : require

// regular attributes
layout (location = 0) in vec3 position;
layout (location = 1) in vec2 textureUV;

// instanced attributes
layout (location = 2) in mat4 transform;
layout (location = 6) in vec2 sampleBottomLeft;
layout (location = 7) in float sampleWidth;
layout (location = 8) in float sampleHeight;

uniform mat4 camera;
uniform mat4 globalTransform;
uniform vec2 imageDimensions;

out vec2 uv;

void main()
{
    gl_Position = camera * globalTransform * transform * vec4(position, 1.0f);
    
    vec2 uvScale = vec2(sampleWidth, sampleHeight) / imageDimensions;
    vec2 uvOffset = sampleBottomLeft / imageDimensions;
    uv = (textureUV * uvScale) + uvOffset;
}